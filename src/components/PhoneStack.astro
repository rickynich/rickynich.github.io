---
import { Image } from "astro:assets";
import type { Shot } from "../data/shots";

/** Three phones fanned in front of a red sun: left, center (front), right. */
interface Props {
  shots: [Shot, Shot, Shot];
  /** Set on the first screen of a page so the center phone isn't lazy-loaded. */
  eager?: boolean;
}

const { shots, eager = false } = Astro.props;
const [left, center, right] = shots;
---

<div class="stack">
  <div class="sun" aria-hidden="true"></div>
  <div class="phone side left">
    <Image src={left.src} alt={left.alt} widths={[240, 360, 480]} sizes="(max-width: 760px) 34vw, 220px" />
  </div>
  <div class="phone side right">
    <Image src={right.src} alt={right.alt} widths={[240, 360, 480]} sizes="(max-width: 760px) 34vw, 220px" />
  </div>
  <div class="phone front">
    <Image
      src={center.src}
      alt={center.alt}
      widths={[300, 450, 600]}
      sizes="(max-width: 760px) 44vw, 270px"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
    />
  </div>
</div>

<style>
  .stack {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    aspect-ratio: 1 / 1.08;
    isolation: isolate;
  }

  .sun {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: -3%;
    width: 104%;
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 42%, var(--seal), color-mix(in srgb, var(--seal) 78%, #000) 100%);
    opacity: 0.95;
  }

  .phone {
    position: absolute;
  }

  .front {
    left: 50%;
    top: 0;
    width: 46%;
    translate: -50% 0;
    z-index: 2;
  }

  .side {
    top: 15%;
    width: 36%;
    z-index: 1;
  }

  .left {
    left: 1%;
    rotate: -7deg;
  }

  .right {
    right: 1%;
    rotate: 7deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .side {
      transition:
        rotate 400ms cubic-bezier(0.2, 0.7, 0.2, 1),
        translate 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .stack:hover .left {
      rotate: -10deg;
      translate: -4% 0;
    }

    .stack:hover .right {
      rotate: 10deg;
      translate: 4% 0;
    }
  }
</style>
