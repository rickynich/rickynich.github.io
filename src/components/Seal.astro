---
/** The NR seal: a name stamp in seal-paste red, used as the logo and favicon. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg
  class:list={["seal", className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label="NR"
>
  <rect x="2" y="2" width="60" height="60" rx="9" fill="var(--seal)"></rect>
  <rect x="7" y="7" width="50" height="50" rx="5" fill="none" stroke="var(--seal-text)" stroke-width="2" opacity="0.9"></rect>
  <text
    x="32"
    y="43.5"
    text-anchor="middle"
    fill="var(--seal-text)"
    font-family="Instrument Serif, Georgia, serif"
    font-size="31"
    letter-spacing="-0.5">NR</text
  >
</svg>

<style>
  .seal {
    flex: none;
  }
</style>
